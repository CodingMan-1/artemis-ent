{
  // ==============================================================================
  // ARTEMIS Autonomous Agent & Framework Configuration
  // FORK: Coding-Man1/artemis —— 企业自建 LLM 单端点版（Qwen3.8-27B 多模态）
  // 上游：google/artemis（默认 Gemini 配置见 upstream main 分支）
  // 接入文档：docs/enterprise-llm.md
  // ==============================================================================

  // ------------------------------------------------------------------------------
  // 1. Global Default Model (Applied to all sub-agents unless overridden below)
  //    provider "openai" = 任意 OpenAI 兼容端点（vLLM / SGLang / 企业网关）
  //    端点地址在 .env 的 OPENAI_BASE_URL 设置（统一网关，无需逐节点配置）
  // ------------------------------------------------------------------------------
  "default": {
    "provider": "openai",
    "model": "qwen3.8-27b",
    "temperature": 0.0,
    "fallback": {
      "provider": "openai",
      "model": "qwen3.8-27b-bak",
      "temperature": 0.0
    }
  },

  // ------------------------------------------------------------------------------
  // 2. Ready-to-Use Presets (Switch easily in code or CLI)
  // ------------------------------------------------------------------------------
  "presets": {
    "ent-default": {
      "provider": "openai",
      "model": "qwen3.8-27b",
      "fallback": { "provider": "openai", "model": "qwen3.8-27b-bak" }
    },
    "local-ollama": {
      "provider": "openai",
      "model": "llama3.2-vision",
      "fallback": { "provider": "openai", "model": "llama3.2-vision" }
    }
  },

  // ------------------------------------------------------------------------------
  // 3. Agent & Sub-Agent Node Customizations (Optional - Inherits from 'default')
  // ------------------------------------------------------------------------------
  "nodes": {
    // All perception/execution nodes (operator, planner, explorer, checker,
    // log_analyzer, diagnoser, outputter, summarizer, pixel safety net ...)
    // inherit the single enterprise endpoint from "default" above.

    // Object Detector: DISABLED on this fork.
    // Upstream pins this node to a Gemini Robotics-ER model (sub-pixel
    // coordinate grounding). A general multimodal model can run it, but
    // accuracy must be validated first:
    //   -> run the grounding mini-benchmark in docs/enterprise-llm.md §4,
    //      then replace null with { "provider": "openai", "model": "qwen3.8-27b" }.
    // Element-index-first locating (accessibility tree) covers native UI in the
    // meantime; raise explorer tier (pro.explorer.mode=ultra) for canvas-heavy pages.
    "object_detector": null,

    // Video Analyzer: inherits the default endpoint (universal multi-model
    // keyframe engine path; the Gemini-native Files-API path is not used here).
    "video_analyzer": {},

    // Explorer: tier is a runtime knob (agent.flash.explorer_mode /
    // agent.pro.explorer.mode), not a model choice; inherits default endpoint.
    "explorer": {},

    // Hopper: fast lightweight package locator (inherits default endpoint).
    "hopper": {},

    // Summarizer / Outputter / Log Analyzer / Diagnoser / Committee / Checker:
    // pure text + screenshot reasoning on the enterprise endpoint; no
    // Gemini-specific thinking/grounding params (they are no-ops outside
    // the GOOGLE provider branch in artemis/llm/router.py).
    "summarizer": {},
    "outputter": {},
    "log_analyzer": {},
    "diagnoser_expert": {},
    "planner_avatar": {},
    "history_analyzer_expert": {},
    "checker": {}
  },

  // ------------------------------------------------------------------------------
  // 4. Runtime Mode & Agent Capabilities Configuration (Dual-Engine: Flash vs. Pro)
  // ------------------------------------------------------------------------------
  "agent": {
    // Flash profile: reactive single-agent loop; unbounded by default, history
    // bounded by transcript compression (context_budget_tokens below) — friendly
    // to 32k-class local models.
    "flash": {
      "max_turns": 0,
      "explorer_mode": "flash",
      "step_summarizer": {
        "enabled": true,
        "model": "qwen3.8-27b",
        "prune_history_xml": true
      }
    },
    // Pro profile: multi-agent graph (Planner -> Operator -> Checker)
    "pro": {
      "explorer": {
        "mode": "flash"
      },
      "planner_validation": {
        "enabled": true
      },
      "committee": {
        "enabled": false,
        "debate_rounds": 2
      },
      "checker": {
        "enabled": true,
        "midway_checks": false,
        "final_check": true,
        "max_iterations": 20,
        "final_check_max_attempts": 3,
        "checkpoint_max_repairs": 2,
        "max_concurrent_checkpoints": 3,
        "checkpoint_timeout": 180.0,
        "settlement_timeout": 120.0,
        "assert_failure_policy": "continue",
        "device_probes": true
      },
      "video_analyzer": {
        "enabled": true,
        "enable_ledger": true
      }
    },
    "memory": {
      "runtime": {
        "max_concurrency": 2,
        "retry_limit": 3,
        "flush_timeout_s": 30
      },
      "transcript": {
        "enabled": true,
        "context_budget_tokens": 80000,
        "start_ratio": 0.35,
        "soft_ratio": 0.7,
        "hard_ratio": 0.9,
        "min_active_steps": 5,
        "image_scrub_depth": 3,
        "image_scrub_depth_relaxed": 6,
        "pending_grace_steps": 3,
        "xml_scrub_depth": 1,
        "similarity_hint": true,
        "similarity_max_distance": 5
      },
      "chunking": {
        "max_steps": 12,
        "min_steps": 3,
        "target_source_tokens": 2000,
        "model": "qwen3.8-27b",
        "max_chunks": 8
      },
      "recall": {
        "enabled": true,
        "max_results": 5,
        "max_text_tokens": 2000,
        "screen_scan_steps": 150
      },
      "replay": {
        "max_steps": 5,
        "max_tokens": 12000
      }
    },
    "video_analyzer": {
      "enabled": true,
      "enable_ledger": true
    },
    "outputter": {
      "enabled": true,
      "force_synthesis": false
    },
    "explorer": {
      "default_version": "flash"
    },
    "explorer_versions": {},
    "denylisted_tools": {
      "explorer": []
    }
  }
}
